{
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/fall-cleanup",
      "destination": "/index.html"
    },
    {
      "source": "/leaf-removal",
      "destination": "/index.html"
    },
    {
      "source": "/quote",
      "destination": "/index.html"
    },
    {
      "source": "/lawn-care/winston",
      "destination": "/index.html"
    },
    {
      "source": "/lawn-care/stewarts-mill",
      "destination": "/index.html"
    },
    {
      "source": "/lawn-care/shallowford-heights",
      "destination": "/index.html"
    },
    {
      "source": "/lawn-care/springwood-village",
      "destination": "/index.html"
    },
    {
      "source": "/lawn-care/big-a",
      "destination": "/index.html"
    },
    {
      "source": "/lawn-care/lithia-springs",
      "destination": "/index.html"
    },
    {
      "source": "/lawn-care/villa-rica",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
